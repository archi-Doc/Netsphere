<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Netsphere.CoreBenchmarks</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Netsphere/Netsphere.csproj" />
  </ItemGroup>
  <Target Name="RemoveUnusedBigMachinesGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'BigMachinesGenerator'" />
    </ItemGroup>
  </Target>
</Project>
